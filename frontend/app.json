{
  "expo": {
    "name": "RigRent",
    "slug": "rigrent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rigrent",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rigrent.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan your license and inspect rigs",
        "NSPhotoLibraryUsageDescription": "Upload rig photos and documents",
        "NSMicrophoneUsageDescription": "Record inspection walkaround videos",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RigRent uses your location in the background to detect when you've arrived at pickup or return, so it can prompt you to start or finish a trip.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.rigrent.app",
      "permissions": ["CAMERA", "RECORD_AUDIO", "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO", "ACCESS_BACKGROUND_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C98A2C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RigRent uses your location to show nearby trucks and trailers, and to tag your listing's pickup location.",
          "locationAlwaysAndWhenInUsePermission": "RigRent uses your location in the background to detect when you've arrived at pickup or return, so it can prompt you to start or finish a trip.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-video",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-camera",
        { "cameraPermission": "Scan your license and inspect rigs" }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload rig photos and documents",
          "cameraPermission": "Scan your license and inspect rigs"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
